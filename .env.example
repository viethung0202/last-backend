# Runtime database connection. Use the pooled URL for the app server.
# Local: docker compose up -d postgres (repo root)
DATABASE_URL="postgresql://hula:hula@localhost:5433/hula"

# Direct database connection. Prisma uses this for migrations.
DIRECT_URL="postgresql://hula:hula@localhost:5433/hula"

# Secret used to sign merchant auth tokens. Replace this in every environment.
JWT_SECRET="replace-with-a-long-random-secret"

# Optional. Defaults to 3000 when omitted.
PORT=3000

# Stores get <slug>.<ROOT_DOMAIN> as their storefront host. "localhost" works in
# browsers for dev (fashion.localhost:5173).
ROOT_DOMAIN="localhost"

# VNPAY Sandbox (platform-wide, merchants only toggle it). Register at
# https://sandbox.vnpayment.vn/devreg/ to get these. Leave empty to disable VNPAY.
# IPN URL to set in the VNPAY portal: https://<public-api>/payments/vnpay/ipn
# (local dev needs a tunnel, e.g. cloudflared/ngrok).
VNPAY_TMN_CODE=""
VNPAY_HASH_SECRET=""
VNPAY_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"

# Comma-separated emails that can open the Platform admin (/platform/*)
PLATFORM_ADMIN_EMAILS="admin@example.com"
