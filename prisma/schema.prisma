// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  name         String
  createdAt    DateTime      @default(now())
  memberships  StoreMember[]
}

model Store {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  // ISO 4217 code; prices are Decimal(12,2) in this currency
  currency  String   @default("VND")
  theme     Json?
  createdAt DateTime @default(now())

  members        StoreMember[]
  domains        StoreDomain[]
  categories     Category[]
  collections    Collection[]
  products       Product[]
  customers      Customer[]
  orders         Order[]
  paymentMethods StorePaymentMethod[]
  discounts      Discount[]
  pages          Page[]
}

enum StoreRole {
  OWNER
  STAFF
}

model StoreMember {
  userId    String
  storeId   String
  user      User      @relation(fields: [userId], references: [id])
  store     Store     @relation(fields: [storeId], references: [id])
  role      StoreRole @default(STAFF)
  createdAt DateTime  @default(now())

  @@id([userId, storeId])
  @@index([storeId])
}

// Hostnames that resolve to a store: <slug>.<ROOT_DOMAIN> by default, custom domains later.
model StoreDomain {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  hostname  String   @unique
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([storeId])
}

model Category {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id])
  name    String
  slug    String

  products Product[]

  @@unique([storeId, slug])
  @@index([storeId])
}

model Collection {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  name      String
  slug      String
  createdAt DateTime @default(now())

  products ProductCollection[]

  @@unique([storeId, slug])
  @@index([storeId])
}

enum ProductStatus {
  DRAFT
  ACTIVE
}

model Product {
  id             String        @id @default(cuid())
  storeId        String
  store          Store         @relation(fields: [storeId], references: [id])
  categoryId     String?
  category       Category?     @relation(fields: [categoryId], references: [id])
  name           String
  description    String?
  vendor         String?
  tags           String[]      @default([])
  seoTitle       String?
  seoDescription String?
  status         ProductStatus @default(DRAFT)
  createdAt      DateTime      @default(now())

  images      ProductImage[]
  options     ProductOption[]
  variants    ProductVariant[]
  collections ProductCollection[]

  @@index([storeId])
  @@index([categoryId])
}

// Image by URL (no upload yet); position 0 is the cover.
model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id])
  url       String
  alt       String?
  position  Int     @default(0)

  @@index([productId])
}

model ProductCollection {
  productId    String
  collectionId String
  product      Product    @relation(fields: [productId], references: [id])
  collection   Collection @relation(fields: [collectionId], references: [id])

  @@id([productId, collectionId])
  @@index([collectionId])
}

model ProductOption {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id])
  name      String
  position  Int     @default(0)

  values ProductOptionValue[]

  @@index([productId])
}

model ProductOptionValue {
  id       String        @id @default(cuid())
  optionId String
  option   ProductOption @relation(fields: [optionId], references: [id])
  value    String

  @@index([optionId])
}

model ProductVariant {
  id             String   @id @default(cuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id])
  sku            String?
  price          Decimal  @db.Decimal(12, 2)
  // strike-through "was" price shown when higher than price
  compareAtPrice Decimal? @db.Decimal(12, 2)
  stock          Int      @default(0)
  // snapshot of the option combination this variant represents, e.g. {"Size":"M","Color":"Red"}
  // kept denormalized so storefront can read a variant's label without joining option/value tables
  optionValues   Json
  createdAt      DateTime @default(now())

  orderItems OrderItem[]

  @@index([productId])
}

model Customer {
  id           String   @id @default(cuid())
  storeId      String
  store        Store    @relation(fields: [storeId], references: [id])
  email        String
  // null = created by guest checkout, no storefront login yet
  passwordHash String?
  name         String
  createdAt    DateTime @default(now())

  orders Order[]

  @@unique([storeId, email])
  @@index([storeId])
}

enum OrderStatus {
  // merchant-created draft: no stock reserved, hidden from the orders list
  DRAFT
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id             String      @id @default(cuid())
  storeId        String
  store          Store       @relation(fields: [storeId], references: [id])
  customerId     String?
  customer       Customer?   @relation(fields: [customerId], references: [id])
  guestEmail     String?
  guestName      String?
  status         OrderStatus @default(PENDING)
  subtotal       Decimal     @default(0) @db.Decimal(12, 2)
  discountCode   String?
  discountAmount Decimal     @default(0) @db.Decimal(12, 2)
  total          Decimal     @db.Decimal(12, 2)
  note           String?
  createdAt      DateTime    @default(now())

  items    OrderItem[]
  payments Payment[]

  @@index([storeId])
  @@index([customerId])
}

model OrderItem {
  id                   String          @id @default(cuid())
  orderId              String
  order                Order           @relation(fields: [orderId], references: [id])
  variantId            String?
  variant              ProductVariant? @relation(fields: [variantId], references: [id])
  productNameSnapshot  String
  variantLabelSnapshot String
  unitPrice            Decimal         @db.Decimal(12, 2)
  quantity             Int

  @@index([orderId])
  @@index([variantId])
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum PaymentMethod {
  COD
  VNPAY
}

// Which checkout methods a store accepts. Missing row = disabled.
model StorePaymentMethod {
  storeId String
  store   Store         @relation(fields: [storeId], references: [id])
  method  PaymentMethod
  enabled Boolean       @default(false)

  @@id([storeId, method])
}

// One row per payment attempt. For VNPAY the row id is sent as vnp_TxnRef.
model Payment {
  id                String        @id @default(cuid())
  orderId           String
  order             Order         @relation(fields: [orderId], references: [id])
  method            PaymentMethod
  // VNPAY: vnp_TransactionNo
  providerPaymentId String?
  status            PaymentStatus @default(PENDING)
  amount            Decimal       @db.Decimal(12, 2)
  paidAt            DateTime?
  createdAt         DateTime      @default(now())

  webhookEvents PaymentWebhookEvent[]

  @@index([orderId])
}

// Raw log of every IPN call (valid or not) for audit/debugging.
model PaymentWebhookEvent {
  id        String   @id @default(cuid())
  provider  String
  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id])
  payload   Json
  // response code we returned, e.g. VNPAY RspCode "00"/"97"
  result    String
  createdAt DateTime @default(now())

  @@index([paymentId])
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

model Discount {
  id          String       @id @default(cuid())
  storeId     String
  store       Store        @relation(fields: [storeId], references: [id])
  // stored uppercase; unique per store
  code        String
  type        DiscountType
  // PERCENTAGE: 1-100, FIXED: amount in Store.currency
  value       Decimal      @db.Decimal(12, 2)
  minSubtotal Decimal?     @db.Decimal(12, 2)
  usageLimit  Int?
  usedCount   Int          @default(0)
  startsAt    DateTime?
  endsAt      DateTime?
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())

  @@unique([storeId, code])
  @@index([storeId])
}

// Page Builder: `draft` is edited freely; publish snapshots it into an immutable PageVersion.
// Data format = Puck JSON: { root: { props }, content: [{ type, props }] } (flat list of sections).
model Page {
  id                 String       @id @default(cuid())
  storeId            String
  store              Store        @relation(fields: [storeId], references: [id])
  // "home" is the storefront home page; others render at #/pages/<slug>
  slug               String
  title              String
  draft              Json
  publishedVersionId String?      @unique
  publishedVersion   PageVersion? @relation("PublishedVersion", fields: [publishedVersionId], references: [id])
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  versions PageVersion[] @relation("PageVersions")

  @@unique([storeId, slug])
  @@index([storeId])
}

model PageVersion {
  id        String   @id @default(cuid())
  pageId    String
  page      Page     @relation("PageVersions", fields: [pageId], references: [id])
  version   Int
  data      Json
  createdAt DateTime @default(now())

  publishedFor Page? @relation("PublishedVersion")

  @@unique([pageId, version])
}
