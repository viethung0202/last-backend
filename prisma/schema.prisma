// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  name         String
  createdAt    DateTime      @default(now())
  memberships  StoreMember[]
}

model Store {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  // ISO 4217 code; prices are Decimal(12,2) in this currency
  currency  String   @default("VND")
  theme     Json?
  createdAt DateTime @default(now())

  members        StoreMember[]
  domains        StoreDomain[]
  categories     Category[]
  collections    Collection[]
  products       Product[]
  customers      Customer[]
  orders         Order[]
  paymentMethods StorePaymentMethod[]
}

enum StoreRole {
  OWNER
  STAFF
}

model StoreMember {
  userId    String
  storeId   String
  user      User      @relation(fields: [userId], references: [id])
  store     Store     @relation(fields: [storeId], references: [id])
  role      StoreRole @default(STAFF)
  createdAt DateTime  @default(now())

  @@id([userId, storeId])
  @@index([storeId])
}

// Hostnames that resolve to a store: <slug>.<ROOT_DOMAIN> by default, custom domains later.
model StoreDomain {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  hostname  String   @unique
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([storeId])
}

model Category {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id])
  name    String
  slug    String

  products Product[]

  @@unique([storeId, slug])
  @@index([storeId])
}

model Collection {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  name      String
  slug      String
  createdAt DateTime @default(now())

  products ProductCollection[]

  @@unique([storeId, slug])
  @@index([storeId])
}

enum ProductStatus {
  DRAFT
  ACTIVE
}

model Product {
  id          String        @id @default(cuid())
  storeId     String
  store       Store         @relation(fields: [storeId], references: [id])
  categoryId  String?
  category    Category?     @relation(fields: [categoryId], references: [id])
  name        String
  description String?
  status      ProductStatus @default(DRAFT)
  createdAt   DateTime      @default(now())

  options     ProductOption[]
  variants    ProductVariant[]
  collections ProductCollection[]

  @@index([storeId])
  @@index([categoryId])
}

model ProductCollection {
  productId    String
  collectionId String
  product      Product    @relation(fields: [productId], references: [id])
  collection   Collection @relation(fields: [collectionId], references: [id])

  @@id([productId, collectionId])
  @@index([collectionId])
}

model ProductOption {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id])
  name      String
  position  Int     @default(0)

  values ProductOptionValue[]

  @@index([productId])
}

model ProductOptionValue {
  id       String        @id @default(cuid())
  optionId String
  option   ProductOption @relation(fields: [optionId], references: [id])
  value    String

  @@index([optionId])
}

model ProductVariant {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  sku          String?
  price        Decimal  @db.Decimal(12, 2)
  stock        Int      @default(0)
  // snapshot of the option combination this variant represents, e.g. {"Size":"M","Color":"Red"}
  // kept denormalized so storefront can read a variant's label without joining option/value tables
  optionValues Json
  createdAt    DateTime @default(now())

  orderItems OrderItem[]

  @@index([productId])
}

model Customer {
  id           String   @id @default(cuid())
  storeId      String
  store        Store    @relation(fields: [storeId], references: [id])
  email        String
  // null = created by guest checkout, no storefront login yet
  passwordHash String?
  name         String
  createdAt    DateTime @default(now())

  orders Order[]

  @@unique([storeId, email])
  @@index([storeId])
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id         String      @id @default(cuid())
  storeId    String
  store      Store       @relation(fields: [storeId], references: [id])
  customerId String?
  customer   Customer?   @relation(fields: [customerId], references: [id])
  guestEmail String?
  guestName  String?
  status     OrderStatus @default(PENDING)
  total      Decimal     @db.Decimal(12, 2)
  createdAt  DateTime    @default(now())

  items    OrderItem[]
  payments Payment[]

  @@index([storeId])
  @@index([customerId])
}

model OrderItem {
  id                   String          @id @default(cuid())
  orderId              String
  order                Order           @relation(fields: [orderId], references: [id])
  variantId            String?
  variant              ProductVariant? @relation(fields: [variantId], references: [id])
  productNameSnapshot  String
  variantLabelSnapshot String
  unitPrice            Decimal         @db.Decimal(12, 2)
  quantity             Int

  @@index([orderId])
  @@index([variantId])
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum PaymentMethod {
  COD
  VNPAY
}

// Which checkout methods a store accepts. Missing row = disabled.
model StorePaymentMethod {
  storeId String
  store   Store         @relation(fields: [storeId], references: [id])
  method  PaymentMethod
  enabled Boolean       @default(false)

  @@id([storeId, method])
}

// One row per payment attempt. For VNPAY the row id is sent as vnp_TxnRef.
model Payment {
  id                String        @id @default(cuid())
  orderId           String
  order             Order         @relation(fields: [orderId], references: [id])
  method            PaymentMethod
  // VNPAY: vnp_TransactionNo
  providerPaymentId String?
  status            PaymentStatus @default(PENDING)
  amount            Decimal       @db.Decimal(12, 2)
  paidAt            DateTime?
  createdAt         DateTime      @default(now())

  webhookEvents PaymentWebhookEvent[]

  @@index([orderId])
}

// Raw log of every IPN call (valid or not) for audit/debugging.
model PaymentWebhookEvent {
  id        String   @id @default(cuid())
  provider  String
  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id])
  payload   Json
  // response code we returned, e.g. VNPAY RspCode "00"/"97"
  result    String
  createdAt DateTime @default(now())

  @@index([paymentId])
}
