// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  stores       Store[]
}

model Store {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id])
  slug      String   @unique
  name      String
  theme     Json?
  isListedOnMarketplace Boolean @default(false)
  createdAt DateTime @default(now())

  categories Category[]
  products   Product[]
  customers  Customer[]
  orders     Order[]

  @@index([ownerId])
}

model Category {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id])
  name    String
  slug    String

  products Product[]

  @@unique([storeId, slug])
  @@index([storeId])
}

enum ProductStatus {
  DRAFT
  ACTIVE
}

model Product {
  id          String        @id @default(cuid())
  storeId     String
  store       Store         @relation(fields: [storeId], references: [id])
  categoryId  String?
  category    Category?     @relation(fields: [categoryId], references: [id])
  name        String
  description String?
  status      ProductStatus @default(DRAFT)
  createdAt   DateTime      @default(now())

  options  ProductOption[]
  variants ProductVariant[]

  @@index([storeId])
  @@index([categoryId])
}

model ProductOption {
  id        String @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id])
  name      String
  position  Int     @default(0)

  values ProductOptionValue[]

  @@index([productId])
}

model ProductOptionValue {
  id       String        @id @default(cuid())
  optionId String
  option   ProductOption @relation(fields: [optionId], references: [id])
  value    String

  @@index([optionId])
}

model ProductVariant {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  sku          String?
  priceCents   Int
  stock        Int      @default(0)
  // snapshot of the option combination this variant represents, e.g. {"Size":"M","Color":"Red"}
  // kept denormalized so storefront can read a variant's label without joining option/value tables
  optionValues Json
  createdAt    DateTime @default(now())

  orderItems OrderItem[]

  @@index([productId])
}

model Customer {
  id           String   @id @default(cuid())
  storeId      String
  store        Store    @relation(fields: [storeId], references: [id])
  email        String
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  orders Order[]

  @@unique([storeId, email])
  @@index([storeId])
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id         String      @id @default(cuid())
  storeId    String
  store      Store       @relation(fields: [storeId], references: [id])
  customerId String?
  customer   Customer?   @relation(fields: [customerId], references: [id])
  guestEmail String?
  guestName  String?
  status     OrderStatus @default(PENDING)
  totalCents Int
  createdAt  DateTime    @default(now())

  items    OrderItem[]
  payments Payment[]

  @@index([storeId])
  @@index([customerId])
}

model OrderItem {
  id                    String          @id @default(cuid())
  orderId               String
  order                 Order           @relation(fields: [orderId], references: [id])
  variantId             String?
  variant               ProductVariant? @relation(fields: [variantId], references: [id])
  productNameSnapshot   String
  variantLabelSnapshot  String
  unitPriceCents        Int
  quantity              Int

  @@index([orderId])
  @@index([variantId])
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

// Account for the cross-store marketplace/discovery site — intentionally has
// no relation to Customer/Order: checkout always happens on the store's own site.
model MarketplaceAccount {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  order             Order         @relation(fields: [orderId], references: [id])
  provider          String
  providerPaymentId String?
  status            PaymentStatus @default(PENDING)
  amountCents       Int
  createdAt         DateTime      @default(now())

  @@index([orderId])
}
