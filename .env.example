# Runtime database connection. Use the pooled URL for the app server.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/DATABASE?pgbouncer=true"

# Direct database connection. Prisma uses this for migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Secret used to sign merchant auth tokens. Replace this in every environment.
JWT_SECRET="replace-with-a-long-random-secret"

# Optional. Defaults to 3000 when omitted.
PORT=3000
